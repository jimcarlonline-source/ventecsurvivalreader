<?xml version='1.0' encoding='utf-8'?>
<widget id="com.ventec.pipreader" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:cdv="http://cordova.apache.org/ns/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">

    <name>VEN-TEC Pip-Reader</name>
    <description>Survival databank and offline ebook reader. Post-apocalypse terminal edition.</description>
    <author email="jimcarlonline@gmail.com" href="https://ven-tec.local">VEN-TEC Industries</author>

    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />

    <!-- App icon: drop a 512x512 PNG at res/icon.png and uncomment the
         icon lines below to brand the launcher. Left out by default so
         the CI build never fails on a missing binary asset. -->
    <!-- <icon src="res/icon.png" /> -->

    <preference name="DisallowOverscroll" value="true" />
    <preference name="BackgroundColor" value="0xff05070a" />
    <preference name="Fullscreen" value="false" />
    <preference name="Orientation" value="portrait" />
    <preference name="SplashMaintainAspectRatio" value="true" />
    <preference name="AndroidPersistentFileLocation" value="Compatibility" />

    <platform name="android">
        <!-- Android 4.1 (API 16) and up -->
        <preference name="android-minSdkVersion" value="16" />
        <preference name="android-targetSdkVersion" value="28" />
    </platform>

    <engine name="android" spec="8.1.0" />
</widget>
